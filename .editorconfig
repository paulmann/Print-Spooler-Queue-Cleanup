root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ps1,psm1,psd1}]
indent_size = 4
# PowerShell is case-insensitive but the convention is PascalCase for names.
max_line_length = off

[*.bat]
# Batch files must be CRLF and pure ASCII: cmd.exe mis-tokenises LF-only files,
# and non-ASCII bytes render as mojibake in the OEM code page. Both are asserted
# by the build.
end_of_line = crlf
charset = latin1
indent_style = space
indent_size = 4
trim_trailing_whitespace = false

[*.{md,yml,yaml,json}]
indent_size = 2
trim_trailing_whitespace = false

[*.xml]
indent_size = 2
